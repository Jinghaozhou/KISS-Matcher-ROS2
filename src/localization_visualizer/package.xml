<?xml version="1.0"?>
<package format="3">
  <name>localization_visualizer</name>
  <version>0.1.0</version>
  <description>Standalone point cloud overlay and RViz view for map localization</description>
  <maintainer email="zhoujinghao188@gmail.com">Jinghao</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
