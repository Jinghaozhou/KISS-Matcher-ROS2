<?xml version="1.0"?>
<package format="3">
  <name>pcd_cloud_publisher</name>
  <version>0.1.0</version>
  <description>Standalone PCD to PointCloud2 publisher for localization input debugging</description>
  <maintainer email="shapelim@mit.edu">Hyungtae Lim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
